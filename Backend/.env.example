# Local development only; configure production values in Vercel project settings.
PORT=5000
NODE_ENV=development

# Database and authentication
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Storefront URLs (must match the deployed frontend origin)
FRONTEND_URL=https://your-storefront-domain.com
PRODUCTION_URL=https://your-storefront-domain.com
BACKEND_URL=https://your-backend-domain.vercel.app

# QuestPay
QUESTPAY_API_KEY=your_questpay_api_key
QUESTPAY_BASE_URL=https://payments-api.questlabs.cc/api
QUESTPAY_WEBHOOK_PATH=/api/webhooks/questpay

# Image and payment-proof storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# Legacy Korapay routes
KORAPAY_PUBLIC_KEY=your_korapay_public_key
KORAPAY_SECRET_KEY=your_korapay_secret_key
