# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=your_mongodb_uri_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend URLs
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=https://yourdomain.com

# Email Configuration
EMAIL_ADDRESS_TO_SEND_CODE=your_email@gmail.com
PASSWORD_TO_EMAIL_ADDRESS_TO_SEND_CODE=your_email_password_here
EMAIL_CHECK_ACCESS_KEY=your_email_check_access_key_here

# Korapay Payment Gateway
KORAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxx
KORAPAY_SECRET_KEY=your_korapay_secret_key_here

# QuestPay Hosted Checkout
QUESTPAY_API_KEY=your_questpay_api_key_here
QUESTPAY_BASE_URL=https://payments-api.questlabs.cc/api
QUESTPAY_WEBHOOK_PATH=/api/webhooks/questpay

# Cloudinary (for image uploads - optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Backend URL (for webhooks)
BACKEND_URL=https://your-backend-domain.com

# Admin Configuration
ADMIN_ROUTE_NAME=admin

# Logging
LOG_LEVEL=info



